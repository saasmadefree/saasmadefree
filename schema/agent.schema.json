{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "status", "runHint", "homepage"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["url", "deeplink", "clipboard"] },
    "template": { "type": ["string", "null"] },
    "homepage": { "type": "string", "format": "uri" },
    "maxLength": { "type": ["integer", "null"], "minimum": 1 },
    "status": { "enum": ["verified", "untested", "not-yet"] },
    "verifiedOn": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "runHint": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "docs": { "type": ["string", "null"], "format": "uri" }
  }
}
