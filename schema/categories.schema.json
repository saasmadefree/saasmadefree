{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "categories.schema.json",
  "type": "object",
  "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["emoji", "label"],
    "properties": {
      "emoji": { "type": "string", "minLength": 1 },
      "label": {
        "type": "object",
        "additionalProperties": false,
        "required": ["en", "fr", "es", "de", "it", "pt", "nl"],
        "properties": {
          "en": { "type": "string", "minLength": 1 },
          "fr": { "type": "string", "minLength": 1 },
          "es": { "type": "string", "minLength": 1 },
          "de": { "type": "string", "minLength": 1 },
          "it": { "type": "string", "minLength": 1 },
          "pt": { "type": "string", "minLength": 1 },
          "nl": { "type": "string", "minLength": 1 }
        }
      },
      "titleLabel": {
        "description": "Groupe nominal court pour les titres (« Newsletter » pour « Newsletters & publishing »). Optionnel, langue par langue : une langue absente retombe sur label.",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "en": { "type": "string", "minLength": 1 },
          "fr": { "type": "string", "minLength": 1 },
          "es": { "type": "string", "minLength": 1 },
          "de": { "type": "string", "minLength": 1 },
          "it": { "type": "string", "minLength": 1 },
          "pt": { "type": "string", "minLength": 1 },
          "nl": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
