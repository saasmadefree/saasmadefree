{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "domains", "category", "pricing", "verdict",
               "verdictConfidence", "moatType", "diyTimeEstimate", "requirements",
               "relatedSlugs", "markets", "pagePriority", "verifiedOneShot"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" }
    },
    "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "subcategory": { "type": "string" },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "plan", "basis", "source", "checkedOn", "confidence"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "plan": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" },
        "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "verdict": { "enum": ["yes", "kinda", "no"] },
    "verdictConfidence": { "enum": ["high", "medium", "low"] },
    "moatType": { "type": "string", "minLength": 1 },
    "diyTimeEstimate": { "enum": ["one-sitting", "weekend", "week", "more"] },
    "requirements": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": ["anthropic-api-key", "openai-api-key", "hosting", "domain",
                 "database", "oauth-app", "email-provider", "none"]
      }
    },
    "priorArt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string" }
        }
      }
    },
    "relatedSlugs": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    },
    "markets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["en", "fr", "es", "de", "it", "pt", "nl"] }
    },
    "pagePriority": { "type": "integer", "minimum": 0, "maximum": 10 },
    "verifiedOneShot": { "type": "boolean" }
  }
}
