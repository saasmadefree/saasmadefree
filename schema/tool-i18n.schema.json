{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-i18n.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["tagline", "verdictSummary", "coreLoopDIY", "whatYouLose",
               "whyPeopleStillPay", "prompt", "faq"],
  "properties": {
    "tagline": { "type": "string", "minLength": 1 },
    "verdictSummary": { "type": "string", "minLength": 1 },
    "coreLoopDIY": { "type": "string", "minLength": 1 },
    "whatYouLose": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "whyPeopleStillPay": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "prompt": { "type": "string", "minLength": 1 },
    "faq": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "a"],
        "properties": {
          "q": { "type": "string", "minLength": 1 },
          "a": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
