{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "homepage", "repo", "selfHostable", "hosted", "deploy",
               "stack", "categories", "markets"],
  "dependentRequired": {
    "selfHostableCheckedOn": ["selfHostableSource"],
    "licenseKind": ["license", "licenseSource"],
    "licenseCheckedOn": ["license", "licenseSource"]
  },
  "if": {
    "required": ["license"],
    "properties": { "license": { "type": "string", "not": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" } } }
  },
  "then": { "required": ["licenseSource"], "properties": { "licenseSource": true } },
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "repo": {
      "oneOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        { "type": "null" }
      ]
    },
    "license": { "type": "string", "minLength": 1 },
    "licenseKind": { "enum": ["open-source", "open-core", "source-available", "fair-code"] },
    "licenseCheckedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "licenseSource": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "selfHostable": { "type": "boolean" },
    "selfHostableCheckedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "selfHostableSource": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "hosted": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exists"],
          "properties": {
            "exists": { "const": false },
            "source": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          "dependentRequired": { "checkedOn": ["source"] }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exists", "priceFrom", "currency", "source", "checkedOn"],
          "properties": {
            "exists": { "const": true },
            "priceFrom": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "source": { "type": "string", "format": "uri", "pattern": "^https?://" },
            "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      ]
    },
    "deploy": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "stack": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9.+-]+$" }
    },
    "categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stars", "lastCommit", "createdAt", "archived", "checkedOn"],
      "properties": {
        "stars": { "type": "integer", "minimum": 0 },
        "lastCommit": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "archived": { "type": "boolean" },
        "checkedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "markets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["en", "fr", "es", "de", "it", "pt", "nl"] }
    }
  }
}
